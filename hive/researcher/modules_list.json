              "NoOperationAuthenticatorFactory"
            ]
          },
          {
            "interface": "ThemeProviderFactory",
            "implementations": [
              "InvitationClasspathThemeProviderFactory"
            ]
          }
        ],
        "features": [
          "Form-based authentication flow",
          "Simple authentication flow",
          "Theme integration for custom forms",
          "Auto-service registration via annotations"
        ]
      },
      {
        "name": "extension-no-op-protocol-mapper",
        "type": "Protocol Mapper SPI",
        "spi_implementations": [
          {
            "interface": "ProtocolMapper",
            "implementations": [
              "NoOperationProtocolMapper"
            ]
          }
        ],
        "features": [
          "Token claim mapping customization",
          "OIDC/SAML protocol support",
          "Auto-service registration via annotations"
        ]
      }
    ]
