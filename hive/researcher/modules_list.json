        "path": "extensions/extension-no-op-authenticator",
        "parent": "extensions",
        "purpose": "Sample no-operation authenticator extension",
        "provides": [
          "NoOperationFormAuthenticator - Form-based auth",
          "NoOperationAuthenticator - Simple auth",
          "InvitationClasspathThemeProvider - Theme integration"
        ],
        "java_packages": [
          "com.inventage.keycloak.noopformauthenticator.infrastructure.authenticator",
