            "common": [
              "Common CSS",
              "Sanitize CSS"
            ]
          },
          "inventage.v2": {
            "account": [
              "Account management styling",
              "i18n messages (DE/EN)"
            ]
          }
        },
        "deployment_target": "../server/target/keycloak/themes",
        "dependencies": ["server"],
        "build_phase": "Fourth - Themes"
      },
      {
        "id": "container",
        "artifactId": "container",
        "packaging": "pom",
        "path": "container",
        "purpose": "Docker container image builder",
        "provides": [
          "Custom Keycloak Docker image",
          "Multi-architecture support (arm64/amd64)",
          "Integrated extensions and themes",
          "Custom entrypoint script"
        ],
        "base_image": "quay.io/keycloak/keycloak:26.4.6",
        "additional_base": "registry.access.redhat.com/ubi9 (for jq and tzdata)",
        "docker_features": [
          "Timezone configuration (Europe/Zurich)",
          "jq utility for JSON processing",
          "Custom entrypoint: /opt/keycloak/bin/kc-with-setup.sh",
          "Optimized build with kc.sh build"
        ],
        "registry": "ghcr.io/inventage/keycloak-custom/",
        "image_name": "com.inventage.keycloak.custom.container",
        "tags": ["latest", "${project.version}"],
        "dependencies": ["server", "config", "extensions", "themes"],
        "build_phase": "Fifth - Container"
      },
      {
        "id": "docker-compose",
        "artifactId": "docker-compose",
        "packaging": "pom",
        "path": "docker-compose",
        "purpose": "Local development orchestration with Docker Compose",
        "provides": [
          "Main Keycloak service configuration",
          "PostgreSQL database service",
          "Mailpit email testing service"
        ],
        "services": {
          "keycloak": {
            "file": "src/main/resources/docker-compose.yml",
            "image": "${docker.registry}${project.groupId}.container:${project.version}",
            "ports": ["8080:8080", "8443:8443"],
            "env_files": [
              "keycloak.common.env",
              "keycloak.specific.env",
              "secrets.env"
            ],
            "networks": ["keycloak"]
          },
          "postgres": {
            "file": "postgres/docker-compose.yml",
            "purpose": "Database backend for Keycloak"
          },
          "mailpit": {
            "file": "mailpit/docker-compose.yml",
            "purpose": "Email testing and debugging"
          }
        },
        "dependencies": ["container"],
        "build_phase": "Sixth - Local Testing"
      },
      {
        "id": "helm",
        "artifactId": "helm",
        "packaging": "helm",
        "path": "helm",
        "purpose": "Kubernetes deployment via Helm chart",
        "provides": [
          "Keycloak Helm chart",
          "OCI registry publishing",
          "Codecentric chart integration"
        ],
        "chart_name": "keycloak-custom-chart",
        "chart_directory": "src/generated/keycloak-custom-chart",
        "source_directory": "src/main/resources",
        "files": [
          "Chart.yaml - Chart metadata",
          "values.yaml - Default configuration values"
        ],
        "helm_version": "3.19.2",
        "registry": "ghcr.io/inventage/keycloak-custom",
        "dependencies": [
          {
            "repository": "https://codecentric.github.io/helm-charts",
            "name": "Codecentric Helm Charts"
          }
        ],
        "build_goals": [
          "init",
          "lint",
          "package",
          "registry-login",
          "push"
        ],
        "dependencies_maven": ["container"],
        "build_phase": "Seventh - Kubernetes Deployment"
      }
    ]
  },

  "extension_modules": {
    "total_count": 2,
    "extensions": [
      {
        "name": "extension-no-op-authenticator",
        "type": "Authenticator SPI + Theme Provider",
        "spi_implementations": [
          {
            "interface": "Authenticator",
            "implementations": [
              "NoOperationFormAuthenticator",
              "NoOperationAuthenticator"
            ]
          },
          {
            "interface": "AuthenticatorFactory",
            "implementations": [
