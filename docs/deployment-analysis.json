    "jobs": {
      "build": {
        "runner": "ubuntu-latest",
        "permissions": ["packages:write"],
        "steps": [
          {
            "name": "Checkout",
            "action": "actions/checkout@v3"
          },
          {
            "name": "Setup JDK",
            "action": "actions/setup-java@v3",
            "javaVersion": "21",
            "distribution": "temurin"
          },
          {
            "name": "Version Replacement",
            "description": "Replace SNAPSHOT with timestamped version",
            "format": "{major}.{minor}.{patch}-{YYYYMMDDHHMM}-{BUILD_NUMBER}-{GIT_HASH}"
          },
          {
            "name": "Maven Build",
            "command": "./mvnw -B -DmultiArchBuild=true -DskipTests deploy",
            "environment": {
              "GITHUB_ACTOR": "${{ github.repository_owner }}",
              "GITHUB_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
            }
          },
          {
            "name": "Cleanup Old Images",
            "action": "actions/delete-package-versions@v4",
            "retention": {
              "minVersions": 5,
              "deleteOnlyPreRelease": true
            },
            "targets": [
              "keycloak-custom/com.inventage.keycloak.custom.container",
              "keycloak-custom/keycloak-custom-chart"
            ]
          }
        ]
      }
    },
    "artifacts": {
      "dockerImage": {
        "registry": "ghcr.io",
        "repository": "inventage/keycloak-custom/com.inventage.keycloak.custom.container"
      },
      "helmChart": {
