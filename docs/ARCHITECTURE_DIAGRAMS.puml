@startuml Keycloak_Custom_System_Architecture
!define ABS(x) ((x) < 0 ? (-(x)) : (x))
skinparam linetype polyline
title Keycloak Custom - Complete System Architecture

package "Keycloak Custom System" {

  package "Client Layer" {
    [Web Browser] as client_web
    [Mobile App] as client_mobile
    [SPA Application] as client_spa
  }

  package "Load Balancer & Ingress" {
    [Kubernetes Ingress] as k8s_ingress
    [Docker Compose Network] as dc_network
  }

  package "Keycloak Application Layer" {

    package "Keycloak 26.4.6 (Quarkus Runtime)" {
      [OIDC/OAuth2 Endpoint] as oidc_endpoint
      [SAML Endpoint] as saml_endpoint
      [Admin Console] as admin_console
      [Account Console] as account_console
      [Metrics Endpoint] as metrics_endpoint
      [Health Endpoint] as health_endpoint
    }

    package "Custom SPI Implementations" {
      [NoOperationAuthenticator] as auth_noop
      [NoOperationFormAuthenticator] as auth_form
      [NoOperationProtocolMapper] as mapper_protocol
      [InvitationThemeProvider] as theme_provider
    }

    package "Custom Themes" {
      [Inventage Theme] as theme_inventage
      [Inventage v2 Theme] as theme_inventage_v2
    }

    package "Core Services" {
      [Session Manager] as session_mgr
      [User Store] as user_store
      [Realm Manager] as realm_mgr
      [Cache Manager] as cache_mgr
      [Logging Service] as log_service
    }
  }

  package "Persistence Layer" {
    [PostgreSQL Database] as postgres
    [Database Schemas] as db_schemas
  }

  package "Supporting Services" {
    [Mailpit (Email Testing)] as mailpit
  }

  package "Deployment Orchestration" {

    package "Container Building" {
      [Maven Build] as mvn_build
      [Docker Multi-Stage Build] as docker_build
      [Multi-Arch Image Builder] as multiarch_build
    }

    package "Container Registry" {
      [GHCR Repository] as ghcr
    }

    package "Kubernetes Deployment" {
      [Helm Chart] as helm_chart
      [Kubernetes ConfigMap] as k8s_configmap
      [Kubernetes Secret] as k8s_secret
      [Kubernetes Deployment] as k8s_deployment
      [Kubernetes Service] as k8s_service
      [Kubernetes Pod] as k8s_pod
    }

    package "Docker Compose" {
      [Docker Compose Orchestrator] as dc_orchestrator
      [Keycloak Container] as dc_keycloak
      [PostgreSQL Container] as dc_postgres
      [Mailpit Container] as dc_mailpit
    }
  }

  package "CI/CD Pipeline" {
    [GitHub Actions] as github_actions
    [Maven Test] as mvn_test
    [Image Build & Push] as image_push
    [Helm Package] as helm_package
  }
}

' Client connections
client_web --> dc_network : HTTP/HTTPS
client_mobile --> dc_network : HTTP/HTTPS
client_spa --> dc_network : HTTP/HTTPS

client_web --> k8s_ingress : HTTP/HTTPS
client_mobile --> k8s_ingress : HTTP/HTTPS
client_spa --> k8s_ingress : HTTP/HTTPS

' Network to application
dc_network --> oidc_endpoint : Route
k8s_ingress --> oidc_endpoint : Route

' Keycloak endpoints
oidc_endpoint --> auth_noop : Auth Flow
oidc_endpoint --> auth_form : Form Auth
oidc_endpoint --> mapper_protocol : Token Mapping

admin_console --> realm_mgr : Config
account_console --> user_store : User Data

' Theme integration
admin_console --> theme_inventage : Render
admin_console --> theme_inventage_v2 : Render
theme_provider --> theme_inventage : Load Resources
theme_provider --> theme_inventage_v2 : Load Resources

' Core services
oidc_endpoint --> session_mgr : Manage
auth_noop --> user_store : Lookup
mapper_protocol --> cache_mgr : Cache Claims
oidc_endpoint --> log_service : Log Events

' Persistence
user_store --> postgres : Query/Store
realm_mgr --> postgres : Query/Store
session_mgr --> postgres : Persist
cache_mgr --> postgres : Cache

' Mailpit integration
oidc_endpoint --> mailpit : Send Emails

' Build pipeline
mvn_build --> docker_build : Artifacts
docker_build --> multiarch_build : Docker
multiarch_build --> ghcr : Push Image

' Kubernetes deployment
helm_chart --> k8s_configmap : Config
helm_chart --> k8s_secret : Secrets
helm_chart --> k8s_deployment : Deploy
k8s_deployment --> k8s_pod : Create
k8s_pod --> ghcr : Pull Image
k8s_pod --> postgres : Connect
k8s_service --> k8s_pod : Balance

' Docker Compose
dc_orchestrator --> dc_keycloak : Orchestrate
dc_orchestrator --> dc_postgres : Orchestrate
dc_orchestrator --> dc_mailpit : Orchestrate
dc_keycloak --> dc_postgres : Connect
dc_keycloak --> dc_mailpit : Connect

' CI/CD
github_actions --> mvn_test : Test
mvn_test --> image_push : Pass
image_push --> helm_package : Build
helm_package --> ghcr : Publish

@enduml

