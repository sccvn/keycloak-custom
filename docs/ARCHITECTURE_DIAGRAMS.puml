@startuml Keycloak_Custom_Extension_Architecture
title Keycloak Custom - Extension Architecture (SPI Pattern)

package "Keycloak Core" {
  [Authenticator\nSPI] as spi_auth
  [ProtocolMapper\nSPI] as spi_mapper
  [ThemeProvider\nSPI] as spi_theme
}

package "Custom Extensions" {

  package "authenticator-extension" {
    [NoOperationAuthenticator] as impl_auth
    [NoOperationFormAuthenticator] as impl_form_auth
    [NoOperationAuthenticatorFactory] as factory_auth
    [InvitationThemeProviderFactory] as factory_theme
  }

  package "protocol-mapper-extension" {
    [NoOperationProtocolMapper] as impl_mapper
    [ProtocolMapperFactory] as factory_mapper
  }
}

package "Service Discovery" {
  [Java SPI\nMechanism] as java_spi
  [META-INF/services] as services_file
}

spi_auth <|.. impl_auth
spi_auth <|.. impl_form_auth
spi_mapper <|.. impl_mapper
spi_theme <|.. factory_theme

impl_auth --> factory_auth
impl_form_auth --> factory_auth
impl_mapper --> factory_mapper
factory_theme --> factory_theme

factory_auth --> java_spi : Auto-discovered
factory_mapper --> java_spi : Auto-discovered
factory_theme --> java_spi : Auto-discovered

java_spi --> services_file
services_file --> services_file : Lists:\nNoOperationAuthenticatorFactory\nNoOperationProtocolMapper\nInvitationThemeProviderFactory

note over impl_auth
  Null Object Pattern
  Bypasses validation
  Demo/Testing only
end note

note over impl_mapper
  Claims Injection
  Configurable per client
  Supports OIDC tokens
end note

note over java_spi
  @AutoService annotation
  Auto-generates service files
  Keycloak discovers at startup
end note

@enduml

@startuml Keycloak_Data_Storage_Schema
title Keycloak Custom - Data Storage & Persistence

database "PostgreSQL\nKeycloak Database" as db {

  package "Realm Tables" {
    table "REALM" {
      REALM_ID : UUID <<pk>>
      NAME : VARCHAR
      ENABLED : BOOLEAN
    }

    table "CLIENT" {
      CLIENT_ID : UUID <<pk>>
      REALM_ID : UUID <<fk>>
      CLIENT_ID_KEY : VARCHAR
      ENABLED : BOOLEAN
    }
  }

  package "User Tables" {
    table "USER_ENTITY" {
      ID : UUID <<pk>>
      REALM_ID : UUID <<fk>>
      USERNAME : VARCHAR
      EMAIL : VARCHAR
      EMAIL_VERIFIED : BOOLEAN
      ENABLED : BOOLEAN
    }

    table "USER_ATTRIBUTE" {
      ID : UUID <<pk>>
      USER_ID : UUID <<fk>>
      NAME : VARCHAR
      VALUE : VARCHAR
    }

    table "USER_ROLE_MAPPING" {
      USER_ID : UUID <<fk>>
      ROLE_ID : UUID <<fk>>
    }
  }

  package "Role Tables" {
    table "KEYCLOAK_ROLE" {
      ID : UUID <<pk>>
      REALM_ID : UUID <<fk>>
      CLIENT_ID : UUID <<fk>>
      NAME : VARCHAR
    }
  }

  package "Session Tables" {
    table "USER_SESSION" {
      ID : VARCHAR <<pk>>
      REALM_ID : UUID <<fk>>
      USER_ID : UUID <<fk>>
      LOGIN_USERNAME : VARCHAR
      CREATED_ON : BIGINT
      LAST_SESSION_REFRESH : BIGINT
    }

    table "CLIENT_SESSION" {
      ID : VARCHAR <<pk>>
      SESSION_ID : VARCHAR <<fk>>
      CLIENT_ID : UUID <<fk>>
      CREATED_ON : BIGINT
    }
  }

  REALM ||--o{ CLIENT
  REALM ||--o{ USER_ENTITY
  REALM ||--o{ KEYCLOAK_ROLE
  REALM ||--o{ USER_SESSION
  USER_ENTITY ||--o{ USER_ATTRIBUTE
  USER_ENTITY ||--o{ USER_ROLE_MAPPING
  KEYCLOAK_ROLE ||--o{ USER_ROLE_MAPPING
  USER_SESSION ||--o{ CLIENT_SESSION
  CLIENT ||--o{ CLIENT_SESSION
}

note right of db
  Schema auto-created by Keycloak
  on first startup
  Supports multi-tenancy via REALM_ID
end note

@enduml

@startuml Keycloak_Configuration_Layers
title Keycloak Custom - Configuration Management Layers

cloud "Kubernetes\nCluster" as k8s_cloud {
  package "Configuration Layer 1: Kubernetes ConfigMap" {
    [keycloak.conf] as k8s_config
    [realm.json] as k8s_realm
  }

  package "Configuration Layer 2: Kubernetes Secret" {
    [DB_PASSWORD] as k8s_db_pass
    [ADMIN_PASSWORD] as k8s_admin_pass
  }
}

cloud "Container\nImage" as container_cloud {
  package "Configuration Layer 2: Build-Time (Baked into image)" {
    [keycloak.conf] as build_config
    [theme JAR files] as build_themes
    [extension JARs] as build_exts
  }
}

cloud "Runtime\nEnvironment" as runtime_cloud {
  package "Configuration Layer 3: Runtime Environment Variables" {
    [KC_DB_URL] as env_db_url
    [KC_HOSTNAME] as env_hostname
    [KC_HTTP_ENABLED] as env_http
  }

  package "Configuration Layer 4: Database (Realm JSON)" {
    [Realm Definition] as db_realm
    [Client Configuration] as db_client
    [User Data] as db_user
  }
}

k8s_cloud --> container_cloud : Mount as volumes
container_cloud --> runtime_cloud : Container startup
runtime_cloud --> db_realm : keycloak-config-cli import
runtime_cloud --> db_client : Admin API
runtime_cloud --> db_user : User Federation

note left of k8s_config
  1. Non-sensitive config
  2. Updated via ConfigMap
  3. No restart needed
end note

note left of k8s_db_pass
  2. Sensitive data
  3. Injected as env vars
  4. Not stored on disk
end note

note left of build_config
  3. Build-time defaults
  5. Baked into image
  6. Can be overridden
end note

note left of env_db_url
  4. Runtime overrides
  5. Highest precedence
  6. Environment-specific
end note

@enduml
